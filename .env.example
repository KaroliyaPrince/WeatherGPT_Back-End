# Application Port (Render automatically sets PORT)
PORT=5000

# Environment Mode (development / production)
NODE_ENV=development

# Google Maps API Key (Optional: OSRM + Public Geocoding fallback used if omitted)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Tomorrow.io Weather API Key (Optional: Open-Meteo fallback used if omitted)
TOMORROW_API_KEY=YOUR_API_KEY

# Route & Place Discovery Settings
ROUTE_SAMPLE_DISTANCE_KM=5
ROUTE_PLACE_MAX_DISTANCE_KM=2
MIN_PLACE_SPACING_KM=10
MAX_INTERMEDIATE_PLACES=10
ROUTE_USE_TRAFFIC=true

# Tomorrow.io Rate Limiting & Concurrency Settings
TOMORROW_RATE_LIMIT_PER_HOUR=20
TOMORROW_RATE_LIMIT_WINDOW_MINUTES=60
WEATHER_CONCURRENCY=2
TOMORROW_API_TIMEOUT_MS=8000

# Weather Cache & Stale-While-Revalidate Settings (Seconds)
WEATHER_CACHE_TTL_SECONDS=600
WEATHER_STALE_MAX_AGE_SECONDS=3600
TTL_HISTORICAL_WEATHER_MS=86400000
